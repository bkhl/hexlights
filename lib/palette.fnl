;; The AJMSX palette by A.J. Otero from https://lospec.com/palette-list/ajmsx

(local l (/ 1 3))
(local h (/ 2 3))

{:black [0 0 0]
 :red [h l l]
 :green [l h l]
 :yellow [h h l]
 :blue [l l h]
 :magenta [h l h]
 :cyan [l h h]
 :white [h h h]
 :bright-black [l l l]
 :bright-red [1 h h]
 :bright-green [h 1 h]
 :bright-blue [h h 1]
 :bright-white [1 1 1]
 :dark-red [l 0 0]
 :dark-olive [l l 0]
 :dark-green [0 l 0]}
